# laurus SUSFS fragment: KSU driver in SUSFS inline-hook mode (replaces KSU_MANUAL_HOOK).
# Kernel side: fs/susfs.c + VFS hooks on the laurus-susfs branch.
CONFIG_LOCALVERSION="-perf-susfs"
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
# logging disabled to keep the kernel image lean
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
# leave OPEN_REDIRECT and SUS_MAP off for the first boot (newest/riskiest)
# CONFIG_KSU_SUSFS_OPEN_REDIRECT is not set
# CONFIG_KSU_SUSFS_SUS_MAP is not set
